# Copy to .env for local development. On Vercel, set these as Project
# Environment Variables instead (the Neon integration provides DATABASE_URL).
# Never commit real values.

# Postgres connection string. On Neon use the POOLED string (host contains
# "-pooler") with sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Invite-only sign-up. Leave blank to close registration completely; set a
# secret phrase and new users must enter it to create an account.
REGISTRATION_CODE=

# Secret for anything needing a shared secret. Use a long random value.
SECRET_KEY=change-me

# Session cookie is Secure (HTTPS-only) by default. Set to false ONLY for
# plain-http local/LAN development.
COOKIE_SECURE=true

# Set true only behind a proxy that overwrites X-Forwarded-For (Vercel does).
# Used so per-address rate limiting sees the real client, not the proxy.
TRUST_FORWARDED_FOR=false

# Optional tuning (defaults shown).
# SESSION_TTL_HOURS=720
# RATE_LIMIT_WINDOW_MINUTES=15
# LOGIN_MAX_FAILURES_PER_USERNAME=10
# LOGIN_MAX_FAILURES_PER_IP=30
# REGISTER_MAX_FAILURES_PER_IP=10
# DB_POOL_MAX_SIZE=5
